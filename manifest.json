{
  "manifest_version": 3,
  "name": "Upwork Job Radar",
  "version": "2.0",
  "description": "Scores every Upwork job on real client quality and rings you the moment a good one lands.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://ntfy.sh/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/find-work/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.upwork.com/nx/find-work/*"],
      "js": ["scoring.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
